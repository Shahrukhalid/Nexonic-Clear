{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Files are only read from and written to locations the user picks in a system dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists"
  ]
}
