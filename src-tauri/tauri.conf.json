{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexonic Clear",
  "version": "0.4.1",
  "identifier": "com.nexonic.clear",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexonic Clear",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "publisher": "Nexonic Technologies",
    "copyright": "Copyright 2026 Nexonic Technologies",
    "category": "Utility",
    "shortDescription": "Inspect and remove metadata from photos, audio, video and PDFs, offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "notices/": "notices/"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG image",
        "mimeType": "image/jpeg",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG image",
        "mimeType": "image/png",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "WebP image",
        "mimeType": "image/webp",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "heic",
          "heif"
        ],
        "name": "HEIC image",
        "mimeType": "image/heic",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "avif"
        ],
        "name": "AVIF image",
        "mimeType": "image/avif",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp4",
          "m4v"
        ],
        "name": "MP4 video",
        "mimeType": "video/mp4",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mov"
        ],
        "name": "QuickTime movie",
        "mimeType": "video/quicktime",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "M4A audio",
        "mimeType": "audio/mp4",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 audio",
        "mimeType": "audio/mpeg",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV audio",
        "mimeType": "audio/wav",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/nexonic-clear.desktop"
      },
      "appimage": {}
    }
  }
}
